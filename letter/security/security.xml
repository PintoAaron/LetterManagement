<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="letter_letter_company_rule" model="ir.rule">
            <field name="name">Letter: restrict to user's companies</field>
            <field name="model_id" ref="model_letter_letter"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="letter_type_company_rule" model="ir.rule">
            <field name="name">Letter Type: restrict to user's companies</field>
            <field name="model_id" ref="model_letter_type"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

</odoo>